
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
        "color": {
            "1": "white"
        },
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "keyWidth": 10,
            "color": {
                "user":"white",
                "at":"white",
                "host":"white",
            }
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "37",  // = color3
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "37",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "37", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "37", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "37", 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "37", 
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "37", 
        },

    ]
}